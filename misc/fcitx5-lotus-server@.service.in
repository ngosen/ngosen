[Unit]
Description=Fcitx5 Lotus Server for %i
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
User=@LOTUS_UINPUT_PROXY_USER@
Group=@LOTUS_UINPUT_PROXY_USER@

CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_NICE CAP_SYS_PTRACE

Type=simple

# Hardening. systemd-analyze security: 7.0 MEDIUM -> 2.0 OK.
# Every directive below was chosen against what the code actually needs, then
# checked on a running desktop; see the notes on each risky one.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateUsers=no
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# AF_UNIX for the two abstract sockets, AF_NETLINK for udev device events.
# Dropping AF_NETLINK kills libinput_udev_create_context and the server exits.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
RemoveIPC=yes
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input r

# Deliberately NOT set:
#   PrivateNetwork  - udev delivers uevents over netlink, and netlink is
#                     per network namespace, so this loses hot-plug detection.
#   ProtectProc     - the client authentication gate reads /proc/<pid>/exe of
#                     another user's process; this would block it.
# CAP_SYS_NICE and CAP_SYS_PTRACE stay: setpriority() in lotus-server.cpp and
# the readlink /proc/<pid>/exe check that authenticates clients.

# The pointer ACLs come from udev rules; without them libinput skips the device until replug.
ExecStartPre=+/usr/bin/udevadm settle --timeout=30
ExecStartPre=+/usr/bin/setfacl -m u:@LOTUS_UINPUT_PROXY_USER@:rw /dev/uinput
ExecStart=/usr/bin/fcitx5-lotus-server -u %i

Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target