#, python-brace-format
msgid "Open the app, switch to Ngó Sen and type “{sample}” ({telex} in Telex). Then choose “Save typing log” in the Ngó Sen menu and read the log here."
msgstr "Mở app, chuyển sang Ngó Sen và gõ “{sample}” (Telex: {telex}). Sau đó chọn “Lưu nhật ký gõ” trong menu Ngó Sen rồi đọc nhật ký ở đây."

#: settings-gui/ui/system_check_dialog.py
msgid "Read typing log"
msgstr "Đọc nhật ký gõ"

#: settings-gui/ui/system_check_dialog.py
msgid "It typed right"
msgstr "Gõ đúng"

#: settings-gui/ui/system_check_dialog.py
msgid "It typed wrong"
msgstr "Gõ sai"

#: settings-gui/ui/system_check_dialog.py
#, python-brace-format
msgid "{app} got the sample right."
msgstr "{app} nhận đúng câu mẫu."

#: settings-gui/ui/system_check_dialog.py
#, python-brace-format
msgid "{app} got the sample wrong."
msgstr "{app} nhận sai câu mẫu."

#: settings-gui/ui/system_check_dialog.py
#, python-brace-format
msgid "{app} does not tell Ngó Sen its text. Did the sample come out right?"
msgstr "{app} không báo chữ cho Ngó Sen. Câu mẫu có hiện đúng không?"

#: settings-gui/ui/system_check_dialog.py
#, python-brace-format
msgid "The app shows: {}"
msgstr "App đang hiện: {}"

#: settings-gui/ui/system_check_dialog.py
msgid "No typing log found. Save one from the Ngó Sen menu first."
msgstr "Chưa có nhật ký gõ. Hãy lưu nhật ký từ menu Ngó Sen trước."

#: settings-gui/ui/system_check_dialog.py
msgid "The log has no typing in it. Type the sample, then save the log again."
msgstr "Nhật ký chưa ghi lần gõ nào. Gõ câu mẫu rồi lưu lại nhật ký."

#: settings-gui/save_log.py
msgid "fcitx5 is not running."
msgstr "fcitx5 không chạy."

#: settings-gui/save_log.py
msgid "Ngó Sen is not loaded. Switch to Ngó Sen once, then run this again."
msgstr "Ngó Sen chưa chạy. Hãy chuyển sang Ngó Sen một lần rồi chạy lại lệnh này."

#: settings-gui/save_log.py
msgid "fcitx5 did not answer."
msgstr "fcitx5 không trả lời."

#: settings-gui/save_log.py
msgid "No desktop session bus. Run this as your own user in a desktop terminal."
msgstr "Không thấy session bus của desktop. Hãy chạy lệnh này bằng user của bạn, trong terminal của desktop."

#: src/ngosen-config.h
msgid "Switch Between English and Vietnamese"
msgstr "Phím chuyển Anh/Việt"

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Tap it alone to switch. The tray icon shows V while typing Vietnamese."
msgstr "Nhấp riêng phím này để chuyển. Biểu tượng khay hiện chữ V khi đang gõ tiếng Việt."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Switch with Ctrl+Shift, as in UniKey?"
msgstr "Chuyển bằng Ctrl+Shift như UniKey?"

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Use Ctrl+Shift"
msgstr "Dùng Ctrl+Shift"

#: settings-gui/ui/pages/dynamic_settings.py
msgid "fcitx5 has other input methods too; its own key still switches to them."
msgstr "fcitx5 còn bộ gõ khác; phím chuyển của fcitx5 vẫn đưa sang các bộ gõ đó."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Sen types straight into the app. Preedit underlines the word until it is done; use it in an app that Sen does not work with."
msgstr "Gõ Sen đưa chữ thẳng vào app. Gạch chân giữ chữ đang gõ có gạch dưới cho tới khi gõ xong; dùng khi app không tương thích với Gõ Sen."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Keep Unicode unless an old document or app needs another one, such as TCVN3 (ABC). Cứu dấu works only with Unicode."
msgstr "Cứ để Unicode, trừ khi văn bản hay app cũ cần bảng mã khác như TCVN3 (ABC). Cứu dấu chỉ chạy với Unicode."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "dd and Space stays đ instead of going back to dd."
msgstr "Gõ dd rồi dấu cách vẫn ra đ, không bị trả về dd."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "hoà, khoẻ, thuý, tuỳ. Off: hòa, khỏe, thúy, tùy."
msgstr "hoà, khoẻ, thuý, tuỳ. Tắt: hòa, khỏe, thúy, tùy."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Non-Start: nhw → như, but w alone stays w. Everywhere: w alone gives ư too. uw always gives ư."
msgstr "Không phải đầu từ: nhw → như, còn w đứng riêng vẫn là w. Mọi nơi: w đứng riêng cũng ra ư. uw thì luôn ra ư."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "ch]a → chưa, m[f → mờ. Type a bracket twice to get it back: [[ → [."
msgstr "ch]a → chưa, m[f → mờ. Gõ ngoặc hai lần để lấy lại dấu ngoặc: [[ → [."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "ban and Space twice gives “ban. ”."
msgstr "Gõ ban rồi hai dấu cách ra “ban. ”."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "a--b → a—b."
msgstr "a--b → a—b."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "ban. tooi → ban. Tôi. The same after Enter."
msgstr "ban. tooi → ban. Tôi. Sau Enter cũng vậy."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "xin → Xin in an empty field or on a new line. Not in address bars or some apps; on GNOME 47 and later, Chrome and similar apps skip an empty field."
msgstr "xin → Xin ở ô trống hoặc đầu dòng mới. Không áp dụng ở thanh địa chỉ và vài app; trên GNOME 47 trở lên, Chrome và app tương tự chưa viết hoa ở ô trống."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Typed tieengs vieetj before switching on? Switch on and it becomes tiếng việt. Tab or Esc gives back what you typed."
msgstr "Lỡ gõ tieengs vieetj khi chưa bật? Bật tiếng Việt là thành tiếng việt. Tab hoặc Esc để trả lại chữ đã gõ."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Select nhanh and type s: nhánh. Tab, Esc or s again gives back s."
msgstr "Bôi đen nhanh rồi gõ s: nhánh. Tab, Esc hoặc gõ s lần nữa để trả lại s."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Opens a menu to pick a mode for the app in use. Only while typing Vietnamese; in English the key types as usual."
msgstr "Mở menu chọn chế độ gõ cho app đang dùng. Chỉ khi đang gõ tiếng Việt; lúc gõ tiếng Anh phím gõ ra như thường."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Moves the app in use to the next mode in the list below, and remembers it for that app."
msgstr "Chuyển app đang dùng sang chế độ kế tiếp trong danh sách bên dưới và nhớ cho app đó."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "With the mode menu open, press a mode's key to pick it for the app in use. Pick Default Typing to make the app follow the switch key again."
msgstr "Khi menu chế độ đang mở, bấm phím của một chế độ để chọn cho app đang dùng. Chọn Chế độ gõ mặc định để app đó lại theo phím chuyển như thường."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Off: plain one-colour icons, in the colour picked below."
msgstr "Tắt: dùng biểu tượng một màu, theo màu chọn bên dưới."

#: settings-gui/ui/pages/dynamic_settings.py
msgid "Only for one-colour icons. Light suits a light panel, Dark a dark one, and Auto follows the light or dark setting of the desktop."
msgstr "Chỉ dùng cho biểu tượng một màu. Sáng hợp panel sáng, Tối hợp panel tối, Tự động theo chế độ sáng/tối của máy."
